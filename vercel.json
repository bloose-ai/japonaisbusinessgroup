{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "https://www.japonaisbusinessgroup.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "japonaisbusinessgroup.com"
        }
      ],
      "destination": "https://www.japonaisbusinessgroup.com/:path*",
      "permanent": true
    }
  ]
}